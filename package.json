{
  "name": "beambox-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "site:dev": "bun run --filter @beamhop/site dev",
    "site:build": "bun run --filter @beamhop/site build",
    "test": "bun test packages",
    "test:e2e": "bun test e2e/build.e2e.test.ts --timeout 600000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:node": "bun run build && bun test e2e/node-compat.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.4",
    "@types/tar-stream": "^3.1.4",
    "tsdown": "^0.16.5",
    "typescript": "^5.9.3",
    "microsandbox": "^0.6.8"
  },
  "dependencies": {
    "microsandbox": "0.6.8"
  }
}
