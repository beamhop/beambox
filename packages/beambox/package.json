{
  "name": "@beamhop/beambox",
  "version": "0.1.0",
  "description": "Build OCI images for microsandbox without Docker. A TypeScript image builder with a Dockerfile front-end.",
  "type": "module",
  "bin": {
    "beambox": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@beamhop/builder": "workspace:*",
    "@beamhop/dockerfile": "workspace:*",
    "@beamhop/microsandbox": "workspace:*",
    "@beamhop/oci": "workspace:*",
    "@beamhop/registry": "workspace:*"
  },
  "keywords": [
    "oci",
    "docker",
    "microsandbox",
    "microvm",
    "container",
    "image",
    "builder"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beamhop/beambox.git",
    "directory": "packages/beambox"
  },
  "homepage": "https://beamhop.github.io/beambox/",
  "bugs": "https://github.com/beamhop/beambox/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
