{
  "name": "@beamhop/dockerfile",
  "version": "0.1.2",
  "description": "Parse Dockerfiles into a typed AST and lower them onto the beambox build engine.",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@beamhop/builder": "workspace:*",
    "@beamhop/oci": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beamhop/beambox.git",
    "directory": "packages/dockerfile"
  },
  "homepage": "https://beamhop.github.io/beambox/",
  "bugs": "https://github.com/beamhop/beambox/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
