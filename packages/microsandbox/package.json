    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@beambox/builder": "workspace:*",
    "@beambox/oci": "workspace:*",
    "@beambox/registry": "workspace:*",
    "tar-stream": "^3.1.7"
  },
  "peerDependencies": {
    "microsandbox": ">=0.6.8"
  },
  "license": "MIT"
}
