{
  "name": "@beambox/microsandbox",
  "version": "0.1.0",
  "description": "Execute Dockerfile RUN steps inside a microsandbox microVM, and load built images straight into its cache. No Docker.",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
