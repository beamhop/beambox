{
  "name": "@beamhop/microsandbox",
  "version": "0.1.0",
  "description": "Execute Dockerfile RUN steps inside a microsandbox microVM, and load built images straight into its cache. No Docker.",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@beamhop/builder": "workspace:*",
    "@beamhop/oci": "workspace:*",
    "@beamhop/registry": "workspace:*",
    "tar-stream": "^3.1.7"
  },
  "peerDependencies": {
    "microsandbox": ">=0.6.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beamhop/beambox.git",
    "directory": "packages/microsandbox"
  },
  "homepage": "https://beamhop.github.io/beambox/",
  "bugs": "https://github.com/beamhop/beambox/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
